# GEMINI_API_KEY: Optional runtime API key for smart features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database Configuration
# Optional: Remote MongoDB connection string. If omitted, applet seamlessly uses persistent embedded document store and Firebase Firestore.
MONGODB_URI=""

# Authentication Security
AUTH_SECRET="velmora-luxury-atelier-secret-key-32-chars-minimum"

# Razorpay Payment Gateway (OPTIONAL for Development & Testing)
# When omitted or empty, VELMORA automatically activates the built-in Sandbox Demo Payment Mode.
# No real payments or credit cards will be processed.
# To connect real Razorpay payments in production, populate the credentials below:
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email Delivery (Resend - Optional)
RESEND_API_KEY=""

# Image Storage (Cloudinary - Optional)
CLOUDINARY_URL=""
