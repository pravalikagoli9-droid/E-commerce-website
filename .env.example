# GEMINI_API_KEY: Optional runtime API key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database Configuration
# Optional: Remote MongoDB connection string. If omitted, applet seamlessly uses persistent embedded document store.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/elixir_noir?retryWrites=true&w=majority"

# Authentication Security
AUTH_SECRET="super-secret-cryptographic-jwt-seed-key-32-chars-minimum"

# Razorpay Payment Gateway (Indian Payment Methods: UPI, Cards, NetBanking)
RAZORPAY_KEY_ID="rzp_test_luxury_key_id"
RAZORPAY_KEY_SECRET="rzp_test_luxury_secret_key"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_key"

# Email Delivery (Resend)
RESEND_API_KEY="re_1234567890abcdef"

# Image Storage (Cloudinary)
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

